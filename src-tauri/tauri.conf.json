{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaToolbox",
  "version": "1.1.1",
  "identifier": "th.mediatoolbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "มีเดียทูลบ็อกซ์ — MediaToolbox",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost http: https: data: blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/*"
    ],
    "shortDescription": "มีเดียทูลบ็อกซ์",
    "longDescription": "โปรแกรมจัดการไฟล์มีเดียครบวงจรสำหรับคนไทย",
    "windows": {
      "nsis": {
        "languages": [
          "Thai",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}